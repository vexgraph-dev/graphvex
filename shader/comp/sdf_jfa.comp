#version 450
// sdf_jfa.comp — seed + jump-flood passes for baked SDF atlases.
//
// One dispatch covers a whole 2048^2 coverage page: glyphs are pre-packed
// with 16px gutters (2x SDF_PADDING), so cross-glyph seed bleed can only
// meet at the clamp boundary where both sides read max distance anyway.
//
// Seeds pack into one uint word (12 bits per axis is plenty for 2048).
// FAR seeds sit just off-page: farther than any real seed can ever be, so
// they lose every argmin where real content exists.
//
// NOTE: seeds live in storage BUFFERS (not images): MoltenVK's Metal
// argument-buffer path rejects the image variant at pipeline creation.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer Cov { uint cov[1048576]; };
layout(set = 0, binding = 1) buffer Sdf { uint sdf[1048576]; }; // combine only
layout(set = 0, binding = 2) buffer SeedsA { uint seedsA[4194304]; };
layout(set = 0, binding = 3) buffer SeedsB { uint seedsB[4194304]; };

layout(push_constant) uniform PC {
    int mode;     // 0 = seed, 1 = flood
    int dstBuf;   // seed: buffer to write; flood: buffer to write (reads other)
    int polarity; // seed: 1 = inside seeds, 0 = outside seeds
    int step;     // flood jump distance (1024 .. 1)
    int dim;      // page dimension (2048)
} pc;

#define FAR_XY 4094

uint packSeed(ivec2 p) { return (uint(p.x) & 0xFFFFu) | (uint(p.y) << 16); }
uint farSeed() { return uint(FAR_XY) | (uint(FAR_XY) << 16); }

uint covByte(ivec2 xy) {
    uint idx = uint(xy.y * pc.dim + xy.x);
    return (cov[idx >> 2] >> (8 * (idx & 3))) & 0xFFu;
}

void storeSeed(uint idx, uint v) {
    if (pc.dstBuf == 0)
        seedsA[idx] = v;
    else
        seedsB[idx] = v;
}

uint loadSeed(uint idx) {
    if (pc.dstBuf == 0)
        return seedsB[idx];
    return seedsA[idx];
}

void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= pc.dim || xy.y >= pc.dim)
        return;
    uint idx = uint(xy.y * pc.dim + xy.x);
    if (pc.mode == 0) {
        bool inside = covByte(xy) > 127u;
        bool want = pc.polarity == 1 ? inside : !inside;
        storeSeed(idx, want ? packSeed(xy) : farSeed());
        return;
    }
    uint best = loadSeed(idx);
    uint sx = best & 0xFFFFu, sy = best >> 16;
    uint dx0 = uint(abs(xy.x - int(sx))), dy0 = uint(abs(xy.y - int(sy)));
    uint bestD = dx0 * dx0 + dy0 * dy0;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            if (i == 0 && j == 0)
                continue;
            ivec2 n = clamp(xy + ivec2(i, j) * pc.step,
                            ivec2(0), ivec2(pc.dim - 1));
            uint nidx = uint(n.y * pc.dim + n.x);
            uint s = (pc.dstBuf == 0) ? seedsB[nidx] : seedsA[nidx];
            uint qx = s & 0xFFFFu, qy = s >> 16;
            uint qdx = uint(abs(xy.x - int(qx)));
            uint qdy = uint(abs(xy.y - int(qy)));
            uint d = qdx * qdx + qdy * qdy;
            if (d < bestD) {
                bestD = d;
                best = s;
            }
        }
    }
    storeSeed(idx, best);
}
