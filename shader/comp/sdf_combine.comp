#version 450
// sdf_combine.comp — nearest-seed fields to stbtt-compatible SDF bytes.
//
// Encoding matches stbtt_GetGlyphSDF with onedge=128, scale=16:
//   val = 128 + 16 * signed_dist, signed_dist positive inside.
// Bytes pack 4-per-word with atomicOr (neighbors share words); the host
// zeroes the buffer before dispatch.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer Cov { uint cov[1048576]; };
layout(set = 0, binding = 1) buffer Sdf { uint sdf[1048576]; };
layout(set = 0, binding = 2) buffer SeedsA { uint seedsA[4194304]; };
layout(set = 0, binding = 3) buffer SeedsB { uint seedsB[4194304]; };

layout(push_constant) uniform PC {
    int inSel;   // buffer holding inside seeds (0 = A, 1 = B)
    int outSel;  // buffer holding outside seeds
    int dim;
    float onedge;
    float distScale;
} pc;

uint covByte(ivec2 xy) {
    uint idx = uint(xy.y * pc.dim + xy.x);
    return (cov[idx >> 2] >> (8 * (idx & 3))) & 0xFFu;
}

void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= pc.dim || xy.y >= pc.dim)
        return;
    uint idx = uint(xy.y * pc.dim + xy.x);
    bool inside = covByte(xy) > 127u;
    float d;
    if (inside) {
        uint s = (pc.outSel == 0) ? seedsA[idx] : seedsB[idx];
        float dx = float(xy.x) - float(s & 0xFFFFu);
        float dy = float(xy.y) - float(s >> 16);
        d = sqrt(dx * dx + dy * dy);
    } else {
        uint s = (pc.inSel == 0) ? seedsA[idx] : seedsB[idx];
        float dx = float(xy.x) - float(s & 0xFFFFu);
        float dy = float(xy.y) - float(s >> 16);
        d = -sqrt(dx * dx + dy * dy);
    }
    uint byte = uint(clamp(pc.onedge + pc.distScale * d, 0.0, 255.0));
    atomicOr(sdf[idx >> 2], byte << (8 * (idx & 3)));
}
